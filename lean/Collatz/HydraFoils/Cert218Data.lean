import Collatz.HydraFoils

/-!
# Data and checker for the #218 defect-1 certificate

The potential `φ` on `x mod 3^10` (found by `sim/hydra_foils/energy.js`), packed 32 entries of 8
bits per leaf in a balanced tree, and the Boolean checker `chk` used by the chunk modules
`Cert218ChunkA/B/C` and assembled in `Collatz.HydraFoils.Cert218`.  The checker uses raw `Nat`
operations and the recursor, so that the kernel reduces it cheaply.
-/

namespace Collatz.HydraFoils.Cert218

noncomputable section

/-- A binary tree of packed table leaves, navigated by the low bits of the index. -/
inductive PTree
  | leaf (v : ℕ)
  | node (l r : PTree)

/-- Leaf lookup, written with the recursor so that the kernel reduces it by iota steps. -/
def PTree.get (t : PTree) : ℕ → ℕ :=
  PTree.rec (motive := fun _ => ℕ → ℕ) (fun v _ => v)
    (fun _ _ fl fr i => cond (Nat.beq (Nat.mod i 2) 0) (fl (Nat.div i 2)) (fr (Nat.div i 2))) t

