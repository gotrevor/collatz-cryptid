/-- The potential `φ` on `x mod 3^10`. -/
def phi (i : ℕ) : ℕ :=
  Nat.mod (Nat.shiftRight (tree.get (Nat.div i 32)) (Nat.mul 8 (Nat.mod i 32))) 256

/-- Positive and negative parts of #218's walk `[3, 1, -1]`. -/
def wP (r : ℕ) : ℕ := cond (Nat.beq r 0) 3 (cond (Nat.beq r 1) 1 0)
def wM (r : ℕ) : ℕ := cond (Nat.beq r 2) 1 0

/-- `(img u + c) mod 3^10` for #218 (`g = [1, 2, 3]`, so `img u = 4⌊u/3⌋ + u mod 3 + 1`). -/
def nxt (u c : ℕ) : ℕ :=
  Nat.mod (Nat.add (Nat.add (Nat.add (Nat.mul 4 (Nat.div u 3)) (Nat.mod u 3)) 1) c) 59049

def ok (u c : ℕ) : Bool :=
  Nat.ble (Nat.add (Nat.add (phi (nxt u c)) 1) (Nat.mul 14 (wP (Nat.mod u 3))))
    (Nat.add (phi (Nat.mod u 59049)) (Nat.mul 14 (wM (Nat.mod u 3))))

def chk (u : ℕ) : Bool := ok u 0 || ok u 1

def allRange (f : ℕ → Bool) (a n : ℕ) : Bool :=
  Nat.rec true (fun k acc => f (Nat.add a k) && acc) n

theorem nxt_eq (u c : ℕ) : nxt u c = (4 * (u / 3) + u % 3 + 1 + c) % 59049 := rfl

theorem ok_eq (u c : ℕ) :
    ok u c = Nat.ble (phi (nxt u c) + 1 + 14 * wP (u % 3)) (phi (u % 59049) + 14 * wM (u % 3)) :=
  rfl

theorem allRange_spec (f : ℕ → Bool) (a : ℕ) :
    ∀ n, allRange f a n = true → ∀ k < n, f (a + k) = true := by
  intro n
  induction n with
  | zero => intro _ k hk; omega
  | succ n ih =>
    intro h k hk
    have h' : (f (a + n) && allRange f a n) = true := h
    rw [Bool.and_eq_true] at h'
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | rfl
    · exact ih h'.2 k hk
    · exact h'.1

theorem of_chunk {a n : ℕ} (h : allRange chk a n = true) (u : ℕ) (h1 : a ≤ u) (h2 : u < a + n) :
    chk u = true := by
  have := allRange_spec chk a n h (u - a) (by omega)
  rwa [show a + (u - a) = u by omega] at this

end

